[Unit]
Description=solar01 hub: history, TOU planner, Home Assistant MQTT bridge, local web UI
Documentation=file:///opt/solar01/current/README.md
After=network-online.target solar01-core.service
Wants=network-online.target
# the legacy planner would fight this one over the inverter
Conflicts=solar-tou.service
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/bin/python3 -m solar01 --config /etc/solar01/config.toml hub
WorkingDirectory=/opt/solar01/current
Environment=PYTHONPATH=/opt/solar01/current PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
User=solar01
Group=solar01
StateDirectory=solar01
StateDirectoryMode=0750
# port 80 without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
WatchdogSec=60
TimeoutStopSec=15
MemoryMax=400M
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/var/lib/solar01

[Install]
WantedBy=multi-user.target
